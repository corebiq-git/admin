rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMatchingClient(data) {
      return request.auth != null && (
        (request.auth.token.keys().hasAny(['email']) &&
          data.clientEmail is string &&
          request.auth.token.email == data.clientEmail) ||
        (request.auth.token.keys().hasAny(['phone_number']) &&
          data.clientMobile is string &&
          request.auth.token.phone_number == data.clientMobile)
      );
    }

    match /clients/{clientId} {
      allow get: if isMatchingClient(resource.data);
      allow list: if isMatchingClient(resource.data);
      allow create, update, delete: if false;
    }

    match /signupRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'mobile', 'message', 'status', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.mobile is string &&
        request.resource.data.mobile.size() <= 20 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is string &&
        (request.resource.data.mobile.matches('^$') ||
          request.resource.data.mobile.matches('^\\+[0-9]{8,15}$'));
      allow get, list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
